@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Mirrors the find_package() calls in the top-level CMakeLists.txt, for the
# dependencies that reach the consumer through the installed public headers.
# yaml-cpp and DataTamer are deliberately absent: they are static FetchContent
# builds embedded into liblast_letter_lib.so, so they are not linked by
# consumers (see the $<BUILD_INTERFACE:> wrapping in CMakeLists.txt).
find_dependency(Eigen3 NO_MODULE)
find_dependency(Boost)

include("${CMAKE_CURRENT_LIST_DIR}/last_letter_libTargets.cmake")

check_required_components(last_letter_lib)
